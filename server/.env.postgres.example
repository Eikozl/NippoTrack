# Separate local PostgreSQL development target. Never point these values at MariaDB.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=jlt_postgres
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=jlt_postgres
POSTGRES_TIMEZONE=America/Santo_Domingo
JLT_ALLOWED_ORIGINS=
# Supabase Auth values are public identifiers, but keep them environment-configured.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173
