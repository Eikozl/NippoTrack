# Safe LOCAL development runtime. Never point these values at Production.
# Plain `npm run dev` loads this file (see scripts/development-environment.js).
# Local PostgreSQL only has the legacy baseline schema, so features needing
# Supabase-auth migrations (Phase 11+) require `npm run dev:integration`.
POSTGRES_RUNTIME_HOST=127.0.0.1
POSTGRES_RUNTIME_PORT=5432
POSTGRES_RUNTIME_USER=jlt_runtime
POSTGRES_RUNTIME_PASSWORD=replace_with_local_jlt_runtime_password
POSTGRES_RUNTIME_DB=jlt_postgres
POSTGRES_RUNTIME_SSL=disable
POSTGRES_RUNTIME_POOL_MAX=2
POSTGRES_TIMEZONE=America/Santo_Domingo
# Auth URL must be explicit and non-Production (the server default is the
# Production project). Local dev reuses the disposable integration project
# for auth only; application data stays in the local database above.
SUPABASE_URL=https://your-disposable-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_AUTH_REDIRECT_URL=http://127.0.0.1:5173
PORT=3000
