{
  "name": "japanese-learning-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Development commands for the Japanese Learning Tracker client and API.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "npm --prefix server start",
    "dev": "node dev.js",
    "dev:integration": "node dev.js --integration",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "test:multi-user-isolation": "npm --prefix server run postgres:test-multi-user-isolation",
    "test:auth-flows": "npm --prefix server run postgres:test-auth-flows",
    "test:postgres-runtime": "npm --prefix server run postgres:test-runtime",
    "db:check": "npm --prefix server run db:check",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "install:all": "npm ci && npm --prefix server ci && npm --prefix client ci",
    "audit": "npm audit --prefix server && npm audit --prefix client"
  },
  "devDependencies": {
    "supabase": "^2.116.0"
  }
}
