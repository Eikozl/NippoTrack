# Dependencies
node_modules/

# Environment variables: every real credential file stays ignored; only
# *.example templates (plus the legacy tracked server/.env.test harness)
# are whitelisted. Never add a new `!` exception without a security review.
.env
.env.*
!.env.example
!.env.*.example
!.env.test

# IDE
.vs/
.vscode/
*.swp
*.swo
*~

# Build outputs
dist/
build/

# Testing
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local database backups
backups/

# Local JMdict dictionary artifacts (downloaded, never committed)
server/.cache-jmdict/

# Supabase CLI local state
supabase/.temp/

# Vercel CLI local build/link state
.vercel/

# Disposable test credentials (tracked TEST_ACCOUNTS.txt is removed at the
# end of testing; this rule prevents recurrence — it cannot untrack it)
TEST_ACCOUNTS.txt

# Builder/test-run artifacts (never committed)
brag-output-*/
*test-output.txt
*test-results.txt
*.docx
