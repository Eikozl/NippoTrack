# Disposable Supabase integration project only. Never use the JLT DEV/production project.
JLT_ALLOW_DESTRUCTIVE_INTEGRATION_TESTS=true
SUPABASE_INTEGRATION_URL=http://127.0.0.1:54321
SUPABASE_INTEGRATION_PUBLISHABLE_KEY=replace_with_local_or_test_publishable_key
SUPABASE_INTEGRATION_SECRET_KEY=replace_with_local_or_test_secret_key
SUPABASE_AUTH_REDIRECT_URL=http://127.0.0.1:5173

# jlt_runtime connection for the same disposable integration database.
POSTGRES_RUNTIME_HOST=127.0.0.1
POSTGRES_RUNTIME_PORT=5432
POSTGRES_RUNTIME_USER=jlt_runtime
POSTGRES_RUNTIME_PASSWORD=replace_with_runtime_password
POSTGRES_RUNTIME_DB=postgres
POSTGRES_RUNTIME_SSL=
POSTGRES_RUNTIME_POOL_MAX=3
POSTGRES_TIMEZONE=America/Santo_Domingo
